DEEPGRAM_API_KEY=dg_...
PORT=3000

# Calendly Personal Access Token: calendly.com -> Integrations -> API & Webhooks -> "Get a token now"
# Works on any Calendly plan for the read/link-creation endpoints this app uses (availability
# lookup + single-use booking links). Direct in-call booking would need a paid-plan Scheduling
# API token instead - not used here.
# OPTIONAL: leave this blank to run in demo mode - canned weekday/business-hours availability
# instead of your real calendar, with the booking link pointing at the real scheduling URL below.
CALENDLY_API_TOKEN=
# The estimate event type's public scheduling URL - used to resolve which event type to check/book.
CALENDLY_EVENT_TYPE_URL=https://calendly.com/your-org/estimate

# Optional overrides - defaults below match what agent.ts uses.
# The think provider is a Deepgram-*managed* LLM (no OpenAI/Anthropic key needed - Deepgram hosts
# and bills it against your Deepgram account). anthropic, open_ai, and google are all managed.
# DEEPGRAM_LLM_PROVIDER=anthropic          # anthropic | open_ai | google
# DEEPGRAM_LLM_MODEL=claude-haiku-4-5      # e.g. claude-sonnet-5 (sharper), gpt-4o, gemini-2.5-flash

# Turn-taking. Default listen model is flux-general-en (Flux v2, semantic end-of-turn = snappier).
# Set to nova-3 to fall back to silence-based VAD if Flux misbehaves.
# DEEPGRAM_LISTEN_MODEL=flux-general-en
# DEEPGRAM_EOT_THRESHOLD=0.7               # 0.5-1.0. lower = faster to respond, more mis-triggers
# DEEPGRAM_EAGER_EOT_THRESHOLD=0.6        # <= EOT_THRESHOLD. LLM starts a beat early
# DEEPGRAM_EOT_TIMEOUT_MS=3000            # hard cap on trailing silence before the turn ends

# TTS voice. Expressive/warm options: aura-2-vesta-en, aura-2-delia-en, aura-2-helena-en, aura-2-luna-en
# DEEPGRAM_SPEAK_MODEL=aura-2-vesta-en
